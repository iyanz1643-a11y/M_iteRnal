# 환경 변수의 이름만 둔다. 값은 비워 두고 실행하는 곳에서 채운다. 채운 .env 는 저장소에 올리지 않는다.
# 뜻은 docs/11_개발구조.md 6장에 있다. 비우면 기본값을 쓴다.

# 웹과 세션
APP_DB=
APP_SECRET=
APP_HTTPS=
APP_BASE_URL=
FORWARDED_ALLOW_IPS=

# 관측과 요청 횟수 제한
APP_SLOW_MS=
APP_RATE_LOGIN_IP=
APP_RATE_LOGIN_ID=
APP_RATE_LANDING_IP=
APP_RATE_CONSULT_IP=

# 파일 저장
APP_STORAGE=
APP_BOARD_DIR=
APP_UPLOAD_DIR=
CONNECT_DATA_DIR=

# 연결
CONNECT_STATE_DB=
CONNECT_STATE_DIR=
CONNECT_WATCH_DIR=
GDRIVE_SERVICE_ACCOUNT_FILE=
GDRIVE_FOLDER_ID=
CARD_SITE_URL=
CARD_ADMIN_KEY=
CARD_SITE_WRITE=

# 앱 AI. 키가 없으면 AI 기능이 꺼진다
ANTHROPIC_API_KEY=
AI_MODEL=
AI_API_VERSION=
AI_TIMEOUT_SECONDS=
AI_MAX_RETRIES=
AI_MONTHLY_LIMIT_USD=
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
AI_KNIGHTS_FILE=

# 상담 신청 랜딩과 영업 배정
APP_CONSULT_OPEN=
APP_SALES_HOLD=
APP_SALES_STALE_DAYS=
APP_SALES_WARN_DAYS=
APP_SALES_NEW_DAYS=

# 워커
WORKER_INTERVAL=
WORKER_WATCH_MINUTES=

# 백업
BACKUP_DIR=
BACKUP_KEY=

# 시험용 compose 의 PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# 샘플 계정. 시험용에서만 쓴다
DEMO_PASSWORD=
